{
  "name": "@weluvabid/structaura",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic AST fingerprinting for JavaScript and TypeScript, powered by Rust and WebAssembly.",
  "sideEffects": false,
  "files": [
    "pkg",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build crates/wasm --target web --release --out-dir ../../pkg",
    "build:grammars": "sh scripts/build-grammars.sh",
    "build": "npm run build:wasm && npm run build:grammars",
    "test:wasm": "wasm-pack test --node crates/wasm",
    "prepublishOnly": "npm run release:verify",
    "test": "node --test",
    "release:verify": "./scripts/check.sh && npm run build && npm run test:wasm && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.27.1"
  },
  "license": "MIT OR Apache-2.0",
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weluvabid/structaura.git"
  },
  "homepage": "https://github.com/weluvabid/structaura#readme",
  "bugs": {
    "url": "https://github.com/weluvabid/structaura/issues"
  },
  "keywords": [
    "ast",
    "fingerprinting",
    "javascript",
    "typescript",
    "tree-sitter",
    "webassembly",
    "wasm",
    "rust"
  ]
}
